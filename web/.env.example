# Local development leaves the gate disabled when these values are absent.
# Production fails closed unless both values are configured.
MVP_ACCESS_CODE=replace-with-at-least-16-characters
MVP_SESSION_SECRET=replace-with-at-least-32-random-characters

DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE_NAME=DrugAndOathRecords
USER_ID=default-user
