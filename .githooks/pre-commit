#!/bin/sh
set -eu

# This public repository needs both boundary and secret checks. Do not replace one
# with the other: the publication guard catches private work material that is not a
# conventional secret, while gitleaks scans staged content for credentials.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit blocked: node is required for the publication boundary check." >&2
  exit 1
fi

node scripts/check-publication-boundary.mjs || {
  echo "pre-commit blocked: keep private material in veai-private." >&2
  exit 1
}

if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --pre-commit --staged --redact; then
    echo ""
    echo "pre-commit blocked: gitleaks detected a staged secret."
    echo "Remove or rotate the secret; do not bypass this hook."
    exit 1
  fi
else
  echo "warning: gitleaks is unavailable; install it to enable the staged secret scan."
fi

# ── 2026-08-20 追加 ───────────────────────────────────────────────
# 異言語混入（BLOCK）: AI が生成した日本語にキリル文字等が紛れることがある。
# 薬機法・医療広告（DELAY）: 警告のみ。「改善」は文脈で正誤が変わるため
#   機械が断定して止めると迂回される。人が判断する。
STAGED=$(git diff --cached --name-only --diff-filter=ACM \
  -- '*.md' '*.html' '*.ts' '*.tsx' '*.js' '*.mjs' '*.py' '*.astro' 2>/dev/null || true)
if [ -n "$STAGED" ]; then
  # shellcheck disable=SC2086
  python3 scripts/check_health_copy.py $STAGED || true   # DELAY: 止めない
  # shellcheck disable=SC2086
  if ! python3 scripts/check_language_contamination.py $STAGED; then
    echo ""
    echo "❌ pre-commit blocked: 想定外の文字体系が混入しています。"
    echo "   迂回せず、該当箇所を修正してください。"
    exit 1
  fi
fi
